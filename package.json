{
  "name": "gitool-file-commit",
  "displayName": "Gitool 文件提交",
  "description": "像 PyCharm 一样按文件选择、提交和推送 Git 变更",
  "version": "0.3.0",
  "publisher": "gitool",
  "license": "MIT",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xbyzzZ/gitool.git"
  },
  "homepage": "https://github.com/xbyzzZ/gitool#readme",
  "bugs": {
    "url": "https://github.com/xbyzzZ/gitool/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onView:gitool.commitView",
    "onCommand:gitool.refresh"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitool",
          "title": "Gitool",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gitool": [
        {
          "type": "webview",
          "id": "gitool.commitView",
          "name": "提交"
        }
      ]
    },
    "commands": [
      {
        "command": "gitool.refresh",
        "title": "Gitool：刷新仓库状态"
      },
      {
        "command": "gitool.editRemote",
        "title": "Gitool：修改远程设置",
        "icon": "$(remote)"
      },
      {
        "command": "gitool.trashUntracked",
        "title": "Gitool：舍弃未跟踪文件",
        "icon": "$(trash)"
      },
      {
        "command": "gitool.openChange",
        "title": "Gitool：打开文件变更"
      },
      {
        "command": "gitool.pull",
        "title": "Gitool：从远程拉取",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitool.pushAll",
        "title": "Gitool：推送全部本地提交",
        "icon": "$(cloud-upload)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('media/main.js',{force:true})\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vscode": "npm run build && node ./dist/test/vscode/run-tests.js",
    "prepare:vscode-gui": "npm run build && node ./dist/test/vscode/prepare-gui-workspace.js",
    "cleanup:vscode-gui": "npm run build && node ./dist/test/vscode/cleanup-gui-workspace.js",
    "build": "node esbuild.mjs",
    "package": "npm run check && npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "26.1.1",
    "@types/vscode": "1.125.0",
    "@vscode/codicons": "^0.0.43",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "jsonc-parser": "3.3.1",
    "mocha": "11.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
